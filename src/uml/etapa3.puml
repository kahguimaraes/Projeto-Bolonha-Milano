@startuml

title Bolonha e Milano - Etapa 3

artifact "main.py" as Main

class Menu {
    - _em_execucao: bool
    - _jogador: Jogador
    - _cidade: Cidade
    - _mercado: Mercado
    + executar()
    - exibir_opcoes()
    - ler_opcao()
    - processar_opcao(opcao)
    - iniciar_novo_jogo()
    - exibir_status()
    - abrir_mercado()
    - ler_quantidade()
    - comprar_graos()
    - vender_graos()
    - comprar_terras()
    - vender_terras()
    - exibir_sobre()
}

class Jogador {
    - _nome: str
    - _titulo: str
    + get_nome()
    + get_titulo()
}

class Cidade {
    - _nome: str
    - _dono: Jogador
    - _ano_atual: int
    - _florins: int
    - _terras: int
    - _graos: int
    + get_nome()
    + get_dono()
    + get_ano_atual()
    + get_florins()
    + get_terras()
    + get_graos()
    + avancar_ano()
    + adicionar_florins(qtd)
    + remover_florins(qtd): bool
    + adicionar_terras(qtd)
    + remover_terras(qtd): bool
    + adicionar_graos(qtd)
    + remover_graos(qtd): bool
    + exibir_status()
}

class Mercado {
    {static} PRECO_GRAO: int = 2
    {static} PRECO_TERRA: int = 1
    + get_preco_grao()
    + get_preco_terra()
    + comprar_graos(cidade, qtd): bool
    + vender_graos(cidade, qtd): bool
    + comprar_terras(cidade, qtd): bool
    + vender_terras(cidade, qtd): bool
}

Main ..> Menu
Menu --> Jogador
Menu --> Cidade
Menu --> Mercado
Cidade --> Jogador : dono
Mercado ..> Cidade : usa

@enduml